method New(oPrint,nPxPerMM) class TLayoutDesigner

    paramtype 1 var oPrint as object class FWMSPRINTER
    paramtype 2 var nPxPerMM as numeric optional default 1

    ::oPrint:=oPrint

    ::nPxPerMM:=1
    ::nPxPerMMX:=1
    ::nPxPerMMY:=1
    ::lRoundCoords:=.F.
    ::SetPxPerMM(nPxPerMM)

    ::nOriginRow:=0
    ::nOriginCol:=0

    ::nColorGrid:=RGB(210,210,210)
    ::nColorGridBack:=RGB(255,255,255)
    ::nColorGridSub:=RGB(230,238,255)
    ::nColorBox:=RGB(255,0,0)
    ::nColorText:=RGB(0,0,0)
    ::nColorPoint:=RGB(0,80,255)

    ::lHighlightGrid:=.T.
    ::lShowGridText:=.T.
    ::lShowMarkInfo:=.T.

    ::cInfoMode:="BOTH"
    ::cGridTextMode:="STEPS"
    ::nTextOffset:=2
    ::nTextLineHeight:=8
    ::nGridSubDivisions:=1
    ::nRulerTextStep:=5
    ::nRulerTickSize:=5

    ::aItems:=Array(0)
    ::aFonts:=Array(0)

    ::oFont:=::CloneFont("Arial",6,.T.)

return(self)

method SetScale(nUnit,nMM) class TLayoutDesigner

    paramtype 1 var nUnit as numeric optional default 0
    paramtype 2 var nMM as numeric optional default 0

    if (nMM>0)
        ::nPxPerMM:=nUnit/nMM
        ::nPxPerMMX:=::nPxPerMM
        ::nPxPerMMY:=::nPxPerMM
    endif

return(self)

method SetScaleX(nUnit,nMM) class TLayoutDesigner

    paramtype 1 var nUnit as numeric optional default 0
    paramtype 2 var nMM as numeric optional default 0

    if (nMM>0)
        ::nPxPerMMX:=nUnit/nMM
    endif

return(self)

method SetScaleY(nUnit,nMM) class TLayoutDesigner

    paramtype 1 var nUnit as numeric optional default 0
    paramtype 2 var nMM as numeric optional default 0

    if (nMM>0)
        ::nPxPerMMY:=nUnit/nMM
    endif

return(self)

method SetScaleXY(nUnitX,nMMX,nUnitY,nMMY) class TLayoutDesigner

    paramtype 1 var nUnitX as numeric optional default 0
    paramtype 2 var nMMX as numeric optional default 0
    paramtype 3 var nUnitY as numeric optional default 0
    paramtype 4 var nMMY as numeric optional default 0

    ::SetScaleX(nUnitX,nMMX)
    ::SetScaleY(nUnitY,nMMY)

return(self)

method SetPageMm(nWidthMM,nHeightMM,nOriginRow,nOriginCol) class TLayoutDesigner

    local nUnitX:=0 as numeric
    local nUnitY:=0 as numeric

    paramtype 1 var nWidthMM as numeric optional default 200
    paramtype 2 var nHeightMM as numeric optional default 130
    paramtype 3 var nOriginRow as numeric optional default 0
    paramtype 4 var nOriginCol as numeric optional default 0

    nUnitX:=nWidthMM*MM2PT
    nUnitY:=nHeightMM*MM2PT

    ::SetOrigin(nOriginRow,nOriginCol)

    if (::IsLegacyFWMSPrinter())
        if ((AttIsMemberOf(::oPrint,"nPageWidth")).and.(::oPrint:nPageWidth>0))
            nUnitX:=::oPrint:nPageWidth
        endif
        if ((AttIsMemberOf(::oPrint,"nPageHeight")).and.(::oPrint:nPageHeight>0))
            nUnitY:=::oPrint:nPageHeight
        endif
    endif

    ::SetScaleXY(nUnitX,nWidthMM,nUnitY,nHeightMM)

return(self)

method SetPxPerMM(nPxPerMM) class TLayoutDesigner

    paramtype 1 var nPxPerMM as numeric optional default 0

    if (nPxPerMM>0)
        ::nPxPerMM:=nPxPerMM
        ::nPxPerMMX:=nPxPerMM
        ::nPxPerMMY:=nPxPerMM
    endif

return(self)

method SetRoundCoords(lRound) class TLayoutDesigner

    paramtype 1 var lRound as logical optional default .F.

    ::lRoundCoords:=lRound

return(self)

method SetOrigin(nRow,nCol) class TLayoutDesigner

    paramtype 1 var nRow as numeric optional default 0
    paramtype 2 var nCol as numeric optional default 0

    ::nOriginRow:=nRow
    ::nOriginCol:=nCol

return(self)

method ResetOrigin() class TLayoutDesigner
return(::SetOrigin(0,0))

method ApplyOrigin(nRow,nCol) class TLayoutDesigner
    paramtype 1 var nRow as numeric optional default 0
    paramtype 2 var nCol as numeric optional default 0
return({nRow+::nOriginRow,nCol+::nOriginCol})

method SetFont(xFont,nSize,lBold,lItalic,lUnderline) class TLayoutDesigner

    paramtype 1 var xFont as character,object optional default "Arial"
    paramtype 2 var nSize as numeric optional default 6
    paramtype 3 var lBold as logical optional default .T.
    paramtype 3 var lItalic as logical optional default .F.
    paramtype 4 var lUnderline as logical optional default .F.

    ::oFont:=::CloneFont(xFont,nSize,lBold,lItalic,lUnderline)

return(self)

method CloneFont(xFont,nSize,lBold,lItalic,lUnderline) class TLayoutDesigner

    local cName:="Arial" as character

    local nWidth as numeric
    local nHeight:=6 as numeric

    local oNewFont as object

    paramtype 1 var xFont as character,object optional default "Arial"
    paramtype 2 var nSize as numeric optional default 6
    paramtype 3 var lBold as logical optional default .T.
    paramtype 4 var lItalic as logical optional default .F.
    paramtype 5 var lUnderline as logical optional default .F.

    if (ValType(nSize)=="N" .and. nSize<>0)
        nHeight:=nSize
    endif

    if (ValType(xFont)=="O")
        if ((AttIsMemberOf(xFont,"Name")).and.(!Empty(xFont:Name)))
            cName:=xFont:Name
        endif
        if (AttIsMemberOf(xFont,"nWidth"))
            nWidth:=xFont:nWidth
        endif
        if ((AttIsMemberOf(xFont,"nHeight")).and.(xFont:nHeight<>0))
            nHeight:=xFont:nHeight
        endif
        if (AttIsMemberOf(xFont,"Bold"))
            lBold:=xFont:Bold
        endif
        if (AttIsMemberOf(xFont,"Italic"))
            lItalic:=xFont:Italic
        endif
        if (AttIsMemberOf(xFont,"Underline"))
            lUnderline:=xFont:Underline
        endif
    elseif ((ValType(xFont)=="C").and.(!Empty(xFont)))
        cName:=xFont
    endif

    //https://tdn.totvs.com/display/tec/TFont
    oNewFont:=TFont():New(cName,nWidth,nHeight,nil,lBold,nil,nil,nil,lUnderline,lItalic)

    if (ValType(::aFonts)!="A")
        ::aFonts:=Array(0)
    endif

    aAdd(::aFonts,oNewFont)

return(oNewFont)

method SetColors(nGrid,nBox,nText,nPoint) class TLayoutDesigner

    paramtype 1 var nGrid as numeric optional default ::nColorGrid
    paramtype 2 var nBox as numeric optional default ::nColorBox
