    public data nColorText as numeric
    public data nColorPoint as numeric

    public data nTextOffset
    public data nTextLineHeight
    public data nRulerTextStep
    public data nRulerTickSize

    public data oFont as object
    public data oPrint as object

    public method New(oPrint as object,nPxPerMM as numeric) as object

    public method SetScale(nUnit as numeric,nMM as numeric) as object
    public method SetScaleX(nUnit as numeric,nMM as numeric) as object
    public method SetScaleY(nUnit as numeric,nMM as numeric) as object
    public method SetScaleXY(nUnitX as numeric,nMMX as numeric,nUnitY as numeric,nMMY as numeric) as object
    public method SetPxPerMM(nPxPerMM as numeric) as object

    public method SetOrigin(nRow as numeric,nCol as numeric) as object
    public method ResetOrigin() as object
    public method ApplyOrigin(nRow as numeric,nCol as numeric) as array

    public method SetFont(xFont as variant,nSize as numeric,lBold as logical) as object
    public method SetColors(nGrid as numeric,nBox as numeric,nText as numeric,nPoint as numeric) as object
    public method SetGridHighlight(lShow as logical,nColorBack as numeric) as object
    public method ShowGridText(lShow as logical) as object
    public method ShowMarkInfo(lShow as logical) as object
    public method SetInfoMode(cMode as character) as object
    public method SetRulerTextStep(nEvery as numeric) as object
    public method SetRulerTickSize(nSize as numeric) as object

    public method MmToPx(nMM as numeric) as numeric
    public method PxToMm(nPx as numeric) as numeric
    public method MmToPxX(nMM as numeric) as numeric
    public method MmToPxY(nMM as numeric) as numeric
    public method PxToMmX(nPx as numeric) as numeric
    public method PxToMmY(nPx as numeric) as numeric
    public method CoordMmToPx(nYmm as numeric,nXmm as numeric) as array
    public method CoordPxToMm(nRow as numeric,nCol as numeric) as array
    public method SizeMmToPx(nWmm as numeric,nHmm as numeric) as array

    public method Grid(nStep as numeric,nHeight as numeric,nWidth as numeric) as object
    public method GridMm(nStepMM as numeric,nHeight as numeric,nWidth as numeric) as object
    public method Ruler(nStep as numeric,nHeight as numeric,nWidth as numeric) as object
    public method RulerMm(nStepMM as numeric,nHeight as numeric,nWidth as numeric) as object

    public method Mark(cName as character,nRow as numeric,nCol as numeric,nWidth as numeric,nHeight as numeric) as object
    public method MarkMm(cName as character,nYmm as numeric,nXmm as numeric,nWmm as numeric,nHmm as numeric) as object
    public method Box(cName as character,nRow as numeric,nCol as numeric,nWidth as numeric,nHeight as numeric) as object
    public method BoxMm(cName as character,nYmm as numeric,nXmm as numeric,nWmm as numeric,nHmm as numeric) as object

    public method Point(cName as character,nRow as numeric,nCol as numeric) as object
    public method PointMm(cName as character,nYmm as numeric,nXmm as numeric) as object

    public method Text(cText as character,nRow as numeric,nCol as numeric) as object
    public method TextMm(cText as character,nYmm as numeric,nXmm as numeric) as object

