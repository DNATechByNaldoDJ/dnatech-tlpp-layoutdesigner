    public data aItems as array

    public data cInfoMode as character

    public data lShowGridText as logical
    public data lShowMarkInfo as logical
    public data lHighlightGrid as logical

    public data nPxPerMM as numeric
    public data nPxPerMMX as numeric
    public data nPxPerMMY as numeric

    public data nOriginRow as numeric
    public data nOriginCol as numeric

    public data nColorGrid as numeric
    public data nColorGridBack as numeric

