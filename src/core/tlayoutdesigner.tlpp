    paramtype 1 var lShow as logical optional default .T.
    ::lShowGridText:=lShow
return(self)

method ShowMarkInfo(lShow) class TLayoutDesigner
    paramtype 1 var lShow as logical optional default .T.
    ::lShowMarkInfo:=lShow
return(self)

method SetInfoMode(cMode) class TLayoutDesigner

    paramtype 1 var cMode as character optional default "BOTH"

    cMode:=Upper(AllTrim(cMode))

    if ((cMode=="BOTH").or.(cMode=="PX").or.(cMode=="MM"))
        ::cInfoMode:=cMode
    endif

return(self)

method SetRulerTextStep(nEvery) class TLayoutDesigner

    paramtype 1 var nEvery as numeric optional default 0

    if (nEvery>0)
        ::nRulerTextStep:=nEvery
    endif

return(self)

method SetRulerTickSize(nSize) class TLayoutDesigner

    paramtype 1 var nSize as numeric optional default 0

    if (nSize>0)
        ::nRulerTickSize:=nSize
    endif

return(self)

method IsLegacyFWMSPrinter() class TLayoutDesigner
return((ValType(::oPrint)=="O").and.(AttIsMemberOf(::oPrint,"nFactorHor")).and.(!AttIsMemberOf(::oPrint,"oFileWriter")))

method PrinterFont(xFont,nSize,lBold,lItalic,lUnderline) class TLayoutDesigner

    local cName:="Arial" as character
    local nHeight:=6 as numeric

    paramtype 1 var xFont as character,object optional default "Arial"
    paramtype 2 var nSize as numeric optional default 6
    paramtype 3 var lBold as logical optional default .T.
    paramtype 4 var lItalic as logical optional default .F.
    paramtype 5 var lUnderline as logical optional default .F.

    if (ValType(nSize)=="N" .and. nSize<>0)
        nHeight:=nSize
    endif

    if (ValType(xFont)=="O")
        if ((AttIsMemberOf(xFont,"Name")).and.(!Empty(xFont:Name)))
            cName:=xFont:Name
        endif
        if ((AttIsMemberOf(xFont,"nHeight")).and.(xFont:nHeight<>0))
            nHeight:=xFont:nHeight
        endif
        if (AttIsMemberOf(xFont,"Bold"))
            lBold:=xFont:Bold
        endif
        if (AttIsMemberOf(xFont,"Italic"))
            lItalic:=xFont:Italic
        endif
        if (AttIsMemberOf(xFont,"Underline"))
            lUnderline:=xFont:Underline
        endif
    elseif ((ValType(xFont)=="C").and.(!Empty(xFont)))
        cName:=xFont
    endif

    if (::IsLegacyFWMSPrinter())
        return({cName,nHeight,lItalic,lBold,lUnderline})
    endif

return(::CloneFont(cName,nHeight,lBold,lItalic,lUnderline))

method MmToPx(nMM) class TLayoutDesigner
    paramtype 1 var nMM as numeric optional default 0
return(::MmToPxX(nMM))

method PxToMm(nPx) class TLayoutDesigner
    paramtype 1 var nPx as numeric optional default 0
return(::PxToMmX(nPx))

method MmToPxX(nMM) class TLayoutDesigner

    local nValue:=0 as numeric

    paramtype 1 var nMM as numeric optional default 0

    if (::nPxPerMMX<=0)
        return(0)
    endif

    nValue:=nMM*::nPxPerMMX

    if (::lRoundCoords)
        return(Round(nValue,0))
    endif

return(nValue)

method MmToPxY(nMM) class TLayoutDesigner

    local nValue:=0 as numeric

    paramtype 1 var nMM as numeric optional default 0

    if (::nPxPerMMY<=0)
        return(0)
    endif

    nValue:=nMM*::nPxPerMMY

    if (::lRoundCoords)
        return(Round(nValue,0))
    endif

return(nValue)

method PxToMmX(nPx) class TLayoutDesigner

    paramtype 1 var nPx as numeric optional default 0

return(Round(::PxToMmXRaw(nPx),2))

method PxToMmY(nPx) class TLayoutDesigner

    paramtype 1 var nPx as numeric optional default 0

return(Round(::PxToMmYRaw(nPx),2))

method PxToMmXRaw(nPx) class TLayoutDesigner

    paramtype 1 var nPx as numeric optional default 0

    if (::nPxPerMMX<=0)
        return(0)
    endif

return(nPx/::nPxPerMMX)

method PxToMmYRaw(nPx) class TLayoutDesigner

    paramtype 1 var nPx as numeric optional default 0

    if (::nPxPerMMY<=0)
        return(0)
    endif

return(nPx/::nPxPerMMY)

method CoordMmToPx(nYmm,nXmm) class TLayoutDesigner

    local nRow:=0 as numeric
    local nCol:=0 as numeric

    paramtype 1 var nYmm as numeric optional default 0
    paramtype 2 var nXmm as numeric optional default 0

    nRow:=::MmToPxY(nYmm)
    nCol:=::MmToPxX(nXmm)

return(::ApplyOrigin(nRow,nCol))

method CoordPxToMm(nRow,nCol) class TLayoutDesigner
    paramtype 1 var nRow as numeric optional default 0
    paramtype 2 var nCol as numeric optional default 0
return({;
     ::PxToMmY(nRow-::nOriginRow);
    ,::PxToMmX(nCol-::nOriginCol);
})

method SizeMmToPx(nWmm,nHmm) class TLayoutDesigner
    paramtype 1 var nWmm as numeric optional default 0
    paramtype 2 var nHmm as numeric optional default 0
return({::MmToPxX(nWmm),::MmToPxY(nHmm)})

method MmToPdf(nMM) class TLayoutDesigner

    paramtype 1 var nMM as numeric optional default 0

return(nMM*MM2PT)

method MmToPrtX(nMM) class TLayoutDesigner

    paramtype 1 var nMM as numeric optional default 0

    if (::nPxPerMMX<=0)
        return(::nOriginCol)
    endif

return(::nOriginCol+(nMM*::nPxPerMMX))

method MmToPrtY(nMM) class TLayoutDesigner

    paramtype 1 var nMM as numeric optional default 0

    if (::nPxPerMMY<=0)
        return(::nOriginRow)
    endif

return(::nOriginRow+(nMM*::nPxPerMMY))

method Grid(nStep,nHeight,nWidth) class TLayoutDesigner

    local nPos:=0 as numeric
    local nIndex:=0 as numeric

    paramtype 1 var nStep as numeric optional default 10
    paramtype 2 var nHeight as numeric optional default 0
    paramtype 3 var nWidth as numeric optional default 0

    if (nStep<=0)
        nStep:=10
    endif

    nIndex:=0
    for nPos:=0 to nHeight step nStep
        ::DrawGuideLine(nPos,0,nPos,nWidth,::nColorGrid)
        if ((::lShowGridText).and.(::cGridTextMode=="STEPS").and.(::IsTextStep(nIndex)))
            ::DrawGuideText(nPos+1,1,::FmtNum(nPos)+"px",::oFont,::nColorGrid)
        endif
        nIndex++
    next nPos

    nIndex:=0
    for nPos:=0 to nWidth step nStep
        ::DrawGuideLine(0,nPos,nHeight,nPos,::nColorGrid)
        if ((::lShowGridText).and.(::cGridTextMode=="STEPS").and.(::IsTextStep(nIndex)))
            ::DrawGuideText(1,nPos+1,::FmtNum(nPos)+"px",::oFont,::nColorGrid)
        endif
        nIndex++
    next nPos

return(self)

method GridMm(nStepMM,nHeight,nWidth) class TLayoutDesigner

    local nPos:=0 as numeric
    local nIndex:=0 as numeric
    local nStepX:=0 as numeric
    local nStepY:=0 as numeric
    local nSubDiv:=::nGridSubDivisions as numeric
    local nSubIndex:=0 as numeric
    local nSubStepMM:=0 as numeric
    local nSubMM:=0 as numeric
    local nMaxMM:=0 as numeric

    paramtype 1 var nStepMM as numeric optional default 5
    paramtype 2 var nHeight as numeric optional default 0
    paramtype 3 var nWidth as numeric optional default 0

    if (nStepMM<=0)
        nStepMM:=5
    endif

    nStepX:=::MmToPxX(nStepMM)
    nStepY:=::MmToPxY(nStepMM)

    if (nStepX<=0)
        nStepX:=10
    endif

    if (nStepY<=0)
        nStepY:=10
    endif

    if (nSubDiv>1)
        nSubStepMM:=nStepMM/nSubDiv

        nMaxMM:=::PxToMmYRaw(nHeight)
        for nSubIndex:=0 to Int(nMaxMM/nSubStepMM)
            if (Mod(nSubIndex,nSubDiv)<>0)
                nSubMM:=nSubIndex*nSubStepMM
                nPos:=::MmToPxY(nSubMM)
                if (nPos<=nHeight)
                    ::DrawGuideLine(nPos,0,nPos,nWidth,::nColorGridSub)
                endif
            endif
        next nSubIndex

        nMaxMM:=::PxToMmXRaw(nWidth)
        for nSubIndex:=0 to Int(nMaxMM/nSubStepMM)
            if (Mod(nSubIndex,nSubDiv)<>0)
                nSubMM:=nSubIndex*nSubStepMM
                nPos:=::MmToPxX(nSubMM)
                if (nPos<=nWidth)
                    ::DrawGuideLine(0,nPos,nHeight,nPos,::nColorGridSub)
                endif
            endif
        next nSubIndex
    endif

    nIndex:=0
    for nPos:=0 to nHeight step nStepY
        ::DrawGuideLine(nPos,0,nPos,nWidth,::nColorGrid)
        if ((::lShowGridText).and.(::cGridTextMode=="STEPS").and.(::IsTextStep(nIndex)))
            ::DrawGuideText(nPos+1,1,::FmtNum(::PxToMmYRaw(nPos)),::oFont,::nColorGrid)
        endif
        nIndex++
    next nPos

    nIndex:=0
    for nPos:=0 to nWidth step nStepX
        ::DrawGuideLine(0,nPos,nHeight,nPos,::nColorGrid)
        if ((::lShowGridText).and.(::cGridTextMode=="STEPS").and.(::IsTextStep(nIndex)))
            ::DrawGuideText(1,nPos+1,::FmtNum(::PxToMmXRaw(nPos)),::oFont,::nColorGrid)
        endif
        nIndex++
    next nPos

    ::DrawGuideLine(nHeight,0,nHeight,nWidth,::nColorGrid)
    ::DrawGuideLine(0,nWidth,nHeight,nWidth,::nColorGrid)

return(self)

method Ruler(nStep,nHeight,nWidth) class TLayoutDesigner

    local nPos:=0
    local nTick:=::nRulerTickSize
    local nIndex:=0

    paramtype 1 var nStep as numeric optional default 10
    paramtype 2 var nHeight as numeric optional default 0
    paramtype 3 var nWidth as numeric optional default 0

    if (nStep<=0)
        nStep:=10
    endif

    for nPos:=0 to nWidth step nStep
        ::DrawGuideLine(0,nPos,nTick,nPos,::nColorGrid)
        ::DrawGuideLine(nHeight-nTick,nPos,nHeight,nPos,::nColorGrid)
        if ((::lShowGridText).and.(::cGridTextMode=="STEPS").and.(::IsTextStep(nIndex)))
            ::DrawGuideText(nTick+1,nPos+1,::FmtNum(nPos)+"px",::oFont,::nColorGrid)
        endif
        nIndex++
    next nPos

    nIndex:=0
    for nPos:=0 to nHeight step nStep
        ::DrawGuideLine(nPos,0,nPos,nTick,::nColorGrid)
        ::DrawGuideLine(nPos,nWidth-nTick,nPos,nWidth,::nColorGrid)
        if ((::lShowGridText).and.(::cGridTextMode=="STEPS").and.(::IsTextStep(nIndex)))
            ::DrawGuideText(nPos+1,nTick+1,::FmtNum(nPos)+"px",::oFont,::nColorGrid)
        endif
        nIndex++
    next nPos

return(self)

method RulerMm(nStepMM,nHeight,nWidth) class TLayoutDesigner

    local nPos:=0 as numeric
    local nTick:=::nRulerTickSize as numeric
    local nIndex:=0 as numeric
    local nStepX:=0 as numeric
    local nStepY:=0 as numeric
    local nSubDiv:=::nGridSubDivisions as numeric
    local nSubIndex:=0 as numeric
    local nSubStepMM:=0 as numeric
    local nSubMM:=0 as numeric
    local nSubTick:=0 as numeric
    local nMaxMM:=0 as numeric
    local cText:="" as character
    local nTextRow:=0 as numeric
    local nTextCol:=0 as numeric
    local nTextWidth:=0 as numeric
    local nTopTextRow:=0 as numeric

    paramtype 1 var nStepMM as numeric optional default 5
    paramtype 2 var nHeight as numeric optional default 0
    paramtype 3 var nWidth as numeric optional default 0

    if (nStepMM<=0)
        nStepMM:=5
    endif

    nStepX:=::MmToPxX(nStepMM)
    nStepY:=::MmToPxY(nStepMM)

    if (nStepX<=0)
        nStepX:=10
    endif

    if (nStepY<=0)
        nStepY:=10
    endif

    nTopTextRow:=0-(::nTextLineHeight+::nTextOffset)
    if (::nOriginRow+nTopTextRow<::nTextOffset)
        nTopTextRow:=nTick+::nTextOffset
    endif

    if (nSubDiv>1)
        nSubStepMM:=nStepMM/nSubDiv
        nSubTick:=Int(nTick/2)

        if (nSubTick<1)
            nSubTick:=1
        endif

        nMaxMM:=::PxToMmXRaw(nWidth)
        for nSubIndex:=0 to Int(nMaxMM/nSubStepMM)
            if (Mod(nSubIndex,nSubDiv)<>0)
                nSubMM:=nSubIndex*nSubStepMM
                nPos:=::MmToPxX(nSubMM)
                if (nPos<=nWidth)
                    ::DrawGuideLine(0,nPos,nSubTick,nPos,::nColorGridSub)
                    ::DrawGuideLine(nHeight-nSubTick,nPos,nHeight,nPos,::nColorGridSub)
                endif
            endif
        next nSubIndex

        nMaxMM:=::PxToMmYRaw(nHeight)
        for nSubIndex:=0 to Int(nMaxMM/nSubStepMM)
            if (Mod(nSubIndex,nSubDiv)<>0)
                nSubMM:=nSubIndex*nSubStepMM
                nPos:=::MmToPxY(nSubMM)
                if (nPos<=nHeight)
                    ::DrawGuideLine(nPos,0,nPos,nSubTick,::nColorGridSub)
                    ::DrawGuideLine(nPos,nWidth-nSubTick,nPos,nWidth,::nColorGridSub)
                endif
            endif
        next nSubIndex
    endif

    for nPos:=0 to nWidth step nStepX
        ::DrawGuideLine(0,nPos,nTick,nPos,::nColorGrid)
        ::DrawGuideLine(nHeight-nTick,nPos,nHeight,nPos,::nColorGrid)
        if ((::lShowGridText).and.(::cGridTextMode=="STEPS").and.(::IsTextStep(nIndex)))
            if ((nPos>0).and.(nPos<nWidth))
                cText:=::FmtNum(::PxToMmXRaw(nPos))
                nTextWidth:=Len(cText)*5
                nTextCol:=nPos-Int(nTextWidth/2)
                if (nTextCol<0)
                    nTextCol:=0
                elseif ((nTextCol+nTextWidth)>nWidth)
                    nTextCol:=nWidth-nTextWidth
                endif
                ::DrawGuideText(nTopTextRow,nTextCol,cText,::oFont,::nColorGrid)
            endif
        endif
        nIndex++
    next nPos

    nIndex:=0
    for nPos:=0 to nHeight step nStepY
        ::DrawGuideLine(nPos,0,nPos,nTick,::nColorGrid)
        ::DrawGuideLine(nPos,nWidth-nTick,nPos,nWidth,::nColorGrid)
        if ((::lShowGridText).and.(::cGridTextMode=="STEPS").and.(::IsTextStep(nIndex)))
            if ((nPos>0).and.(nPos<nHeight))
                cText:=::FmtNum(::PxToMmYRaw(nPos))
                nTextCol:=0-((Len(cText)*4)+::nTextOffset)
                if (::nOriginCol+nTextCol<::nTextOffset)
                    nTextCol:=nTick+::nTextOffset
                endif
                nTextRow:=nPos+1
                if ((nTextRow+::nTextLineHeight)>nHeight)
                    nTextRow:=nHeight-::nTextLineHeight
                endif
                ::DrawGuideText(nTextRow,nTextCol,cText,::oFont,::nColorGrid)
            endif
        endif
        nIndex++
    next nPos

    ::DrawGuideLine(0,nWidth,nTick,nWidth,::nColorGrid)
    ::DrawGuideLine(nHeight-nTick,nWidth,nHeight,nWidth,::nColorGrid)
    ::DrawGuideLine(nHeight,0,nHeight,nTick,::nColorGrid)
    ::DrawGuideLine(nHeight,nWidth-nTick,nHeight,nWidth,::nColorGrid)

    if ((::lShowGridText).and.(::cGridTextMode<>"NONE"))
        ::DrawMmCornerText(nHeight,nWidth,::nColorGrid)
    endif

return(self)

method Mark(cName,nRow,nCol,nWidth,nHeight,nColorBox,cPixel) class TLayoutDesigner

    local aInfo as array

    local nLine as numeric

    paramtype 1 var cName as character optional default "AREA"
    paramtype 2 var nRow as numeric optional default 0
    paramtype 3 var nCol as numeric optional default 0
    paramtype 4 var nWidth as numeric optional default 40
    paramtype 5 var nHeight as numeric optional default 10
    paramtype 6 var nColorBox as numeric optional default ::nColorBox
    paramtype 7 var cPixel as character optional

    ::DrawBox(nRow,nCol,nRow+nHeight,nCol+nWidth,nColorBox,cPixel)
    ::AddItem("MARK",cName,nRow,nCol,nWidth,nHeight)

    if (::lShowMarkInfo)
        aInfo:=::InfoLines(cName,nRow,nCol,nWidth,nHeight)
        for nLine:=1 to Len(aInfo)
            ::DrawText(;
                 nRow+nHeight+::nTextOffset+((nLine-1)*::nTextLineHeight);
                ,nCol;
                ,aInfo[nLine],::oFont,::nColorText;
            )
        next nLine
        FWFreeArray(@aInfo)
    endif

return(self)

method MarkMm(cName,nYmm,nXmm,nWmm,nHmm,nColorBox,cPixel) class TLayoutDesigner
    paramtype 1 var cName as character optional default "AREA"
    paramtype 2 var nYmm as numeric optional default 0
    paramtype 3 var nXmm as numeric optional default 0
    paramtype 4 var nWmm as numeric optional default 40
    paramtype 5 var nHmm as numeric optional default 10
    paramtype 6 var nColorBox as numeric optional
    paramtype 7 var cPixel as character optional
return(::Mark(cName,::MmToPxY(nYmm),::MmToPxX(nXmm),::MmToPxX(nWmm),::MmToPxY(nHmm),nColorBox,cPixel))

method Box(cName,nRow,nCol,nWidth,nHeight,nColorBox,cPixel) class TLayoutDesigner

    paramtype 1 var cName as character optional default "BOX"
    paramtype 2 var nRow as numeric optional default 0
    paramtype 3 var nCol as numeric optional default 0
    paramtype 4 var nWidth as numeric optional default 40
    paramtype 5 var nHeight as numeric optional default 10
    paramtype 6 var nColorBox as numeric optional default ::nColorBox
    paramtype 7 var cPixel as character optional

    ::DrawBox(nRow,nCol,nRow+nHeight,nCol+nWidth,nColorBox,cPixel)
    ::AddItem("BOX",cName,nRow,nCol,nWidth,nHeight)

return(self)

method BoxMm(cName,nYmm,nXmm,nWmm,nHmm,nColorBox,cPixel) class TLayoutDesigner
    paramtype 1 var cName as character optional default "BOX"
    paramtype 2 var nYmm as numeric optional default 0
    paramtype 3 var nXmm as numeric optional default 0
    paramtype 4 var nWmm as numeric optional default 40
    paramtype 5 var nHmm as numeric optional default 10
    paramtype 6 var nColorBox as numeric optional
    paramtype 7 var cPixel as character optional
return(::Box(cName,::MmToPxY(nYmm),::MmToPxX(nXmm),::MmToPxX(nWmm),::MmToPxY(nHmm),nColorBox,cPixel))

method BaselineMm(cName,nYmm,nXmm,nWmm) class TLayoutDesigner

    local nRow:=0 as numeric
    local nCol:=0 as numeric
    local nWidth:=0 as numeric

    paramtype 1 var cName as character optional default "BASELINE"
    paramtype 2 var nYmm as numeric optional default 0
    paramtype 3 var nXmm as numeric optional default 0
    paramtype 4 var nWmm as numeric optional default 200

    nRow:=::MmToPxY(nYmm)
    nCol:=::MmToPxX(nXmm)
    nWidth:=::MmToPxX(nWmm)

    ::DrawLine(nRow,nCol,nRow,nCol+nWidth,::nColorPoint)
    ::AddItem("BASELINE",cName,nRow,nCol,nWidth,0,"BASELINE","",0,.F.,0,nYmm,nXmm,nWmm,0,"")

return(self)

method CrossMm(cName,nYmm,nXmm,nSizeMm) class TLayoutDesigner

    local nRow:=0 as numeric
    local nCol:=0 as numeric
    local nHalfH:=0 as numeric
    local nHalfW:=0 as numeric

    paramtype 1 var cName as character optional default "CROSS"
    paramtype 2 var nYmm as numeric optional default 0
    paramtype 3 var nXmm as numeric optional default 0
    paramtype 4 var nSizeMm as numeric optional default 3

    nRow:=::MmToPxY(nYmm)
    nCol:=::MmToPxX(nXmm)
    nHalfH:=::MmToPxY(nSizeMm)/2
    nHalfW:=::MmToPxX(nSizeMm)/2

    ::DrawLine(nRow-nHalfH,nCol,nRow+nHalfH,nCol,::nColorPoint)
    ::DrawLine(nRow,nCol-nHalfW,nRow,nCol+nHalfW,::nColorPoint)
    ::AddItem("CROSS",cName,nRow,nCol,::MmToPxX(nSizeMm),::MmToPxY(nSizeMm),"CROSS","",0,.F.,0,nYmm,nXmm,nSizeMm,nSizeMm,"")

return(self)

method CalibSay(cName,cText,nYmm,nXmm,oFont,nFontSize,cFont,lBold) class TLayoutDesigner

    local nRow:=0 as numeric
    local nCol:=0 as numeric
    local xSayFont as variant

    paramtype 1 var cName as character optional default "CALIB_SAY"
    paramtype 2 var cText as character optional default ""
    paramtype 3 var nYmm as numeric optional default 0
    paramtype 4 var nXmm as numeric optional default 0
    paramtype 5 var oFont as object optional default ::oFont
    paramtype 6 var nFontSize as numeric optional default 0
    paramtype 7 var cFont as character optional default ""
    paramtype 8 var lBold as logical optional default .T.

    nRow:=::MmToPxY(nYmm)
    nCol:=::MmToPxX(nXmm)

    ::BaselineMm(cName+"_BASE",nYmm,nXmm,60)
    ::CrossMm(cName+"_ORIG",nYmm,nXmm,3)

    if (ValType(::oPrint)=="O")
        xSayFont:=::PrinterFont(oFont,nFontSize,lBold)
        if (::IsLegacyFWMSPrinter())
            ::oPrint:Say(::MmToPrtY(nYmm),::MmToPrtX(nXmm),cText,xSayFont,0,::nColorText)
        else
            ::oPrint:Say(::MmToPrtY(nYmm),::MmToPrtX(nXmm),cText,xSayFont)
        endif
        if (ValType(xSayFont)=="O")
            FreeObj(@xSayFont)
        elseif (ValType(xSayFont)=="A")
            FWFreeArray(@xSayFont)
        endif
    endif

    ::AddItem("CALIB",cName,nRow,nCol,0,0,"SAY",cFont,nFontSize,lBold,0,nYmm,nXmm,0,0,cText)

return(self)

method CalibSayAlign(cName,cText,nYmm,nXmm,oFont,nWidthMm,nHeightMm,nHAlign,nVAlign,nFontSize,cFont,lBold,nColorBox,cPixel) class TLayoutDesigner

    local nRow:=0 as numeric
    local nCol:=0 as numeric
    local nWidth:=0 as numeric
    local nHeight:=0 as numeric
    local xSayFont as variant

    paramtype 1 var cName as character optional default "CALIB_SAYALIGN"
    paramtype 2 var cText as character optional default ""
    paramtype 3 var nYmm as numeric optional default 0
    paramtype 4 var nXmm as numeric optional default 0
    paramtype 5 var oFont as object optional default ::oFont
    paramtype 6 var nWidthMm as numeric optional default 60
    paramtype 7 var nHeightMm as numeric optional default 10
    paramtype 8 var nHAlign as numeric optional default 2
    paramtype 9 var nVAlign as numeric optional default 2
    paramtype 10 var nFontSize as numeric optional default 0
    paramtype 11 var cFont as character optional default ""
    paramtype 12 var lBold as logical optional default .T.
    paramtype 13 var nColorBox as numeric optional
    paramtype 14 var cPixel as character optional

    nRow:=::MmToPxY(nYmm)
    nCol:=::MmToPxX(nXmm)
    nWidth:=::MmToPxX(nWidthMm)
    nHeight:=::MmToPxY(nHeightMm)

    ::CalibBoxMm(cName+"_BOX",nYmm,nXmm,nWidthMm,nHeightMm,nColorBox,cPixel)

    if (ValType(::oPrint)=="O")
        xSayFont:=::PrinterFont(oFont,nFontSize,lBold)
        if (::IsLegacyFWMSPrinter())
            ::oPrint:Say(::MmToPrtY(nYmm),::MmToPrtX(nXmm),cText,xSayFont,0,::nColorText)
        else
            ::oPrint:SayAlign(::MmToPrtY(nYmm),::MmToPrtX(nXmm),cText,xSayFont,nWidth,nHeight,nil,nHAlign,nVAlign)
        endif
        if (ValType(xSayFont)=="O")
            FreeObj(@xSayFont)
        elseif (ValType(xSayFont)=="A")
            FWFreeArray(@xSayFont)
        endif
    endif

    ::AddItem("CALIB",cName,nRow,nCol,nWidth,nHeight,"SAYALIGN",cFont,nFontSize,lBold,0,nYmm,nXmm,nWidthMm,nHeightMm,cText)

return(self)

method CalibBoxMm(cName,nYmm,nXmm,nWmm,nHmm,nColorBox,cPixel) class TLayoutDesigner

    local nRow:=0 as numeric
    local nCol:=0 as numeric
    local nWidth:=0 as numeric
    local nHeight:=0 as numeric

    paramtype 1 var cName as character optional default "CALIB_BOX"
    paramtype 2 var nYmm as numeric optional default 0
    paramtype 3 var nXmm as numeric optional default 0
    paramtype 4 var nWmm as numeric optional default 40
    paramtype 5 var nHmm as numeric optional default 10
    paramtype 6 var nColorBox as numeric optional default ::nColorBox
    paramtype 7 var cPixel as character optional

    nRow:=::MmToPxY(nYmm)
    nCol:=::MmToPxX(nXmm)
    nWidth:=::MmToPxX(nWmm)
    nHeight:=::MmToPxY(nHmm)

    ::DrawBox(nRow,nCol,nRow+nHeight,nCol+nWidth,nColorBox,cPixel)
    ::AddItem("CALIBBOX",cName,nRow,nCol,nWidth,nHeight,"BOX","",0,.F.,0,nYmm,nXmm,nWmm,nHmm,"")

return(self)

method Point(cName,nRow,nCol) class TLayoutDesigner

    local aInfo as array
    local nLine as numeric

    paramtype 1 var cName as character optional default "PONTO"
    paramtype 2 var nRow as numeric optional default 0
    paramtype 3 var nCol as numeric optional default 0

    ::DrawLine(nRow-3,nCol,nRow+3,nCol,::nColorPoint)
    ::DrawLine(nRow,nCol-3,nRow,nCol+3,::nColorPoint)
    ::AddItem("POINT",cName,nRow,nCol,0,0)

    if (::lShowMarkInfo)
        aInfo:=::InfoLines(cName,nRow,nCol,0,0)
        for nLine:=1 to Len(aInfo)
            ::DrawText(;
                 nRow+4+((nLine-1)*::nTextLineHeight);
                ,nCol+4;
                ,aInfo[nLine],::oFont,::nColorText;
            )
        next nLine
        FWFreeArray(@aInfo)
    endif

return(self)

method PointMm(cName,nYmm,nXmm) class TLayoutDesigner
    paramtype 1 var cName as character optional default "PONTO"
    paramtype 2 var nYmm as numeric optional default 0
    paramtype 3 var nXmm as numeric optional default 0
return(::Point(cName,::MmToPxY(nYmm),::MmToPxX(nXmm)))

