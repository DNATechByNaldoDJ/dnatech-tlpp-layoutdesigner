    paramtype 1 var cText as character optional default ""
    paramtype 2 var nRow as numeric optional default 0
    paramtype 3 var nCol as numeric optional default 0

    ::DrawText(nRow,nCol,cText,::oFont,::nColorText)
    ::AddItem("TEXT",cText,nRow,nCol,0,0)

return(self)

method TextMm(cText,nYmm,nXmm) class TLayoutDesigner
    paramtype 1 var cText as character optional default ""
    paramtype 2 var nYmm as numeric optional default 0
    paramtype 3 var nXmm as numeric optional default 0
return(::Text(cText,::MmToPxY(nYmm),::MmToPxX(nXmm)))

method AddItem(cType,cName,nRow,nCol,nWidth,nHeight,cMethod,cFont,nFontSize,lBold,nOrient,nYmm,nXmm,nWmm,nHmm,cObs) class TLayoutDesigner

    local jItem:=JSONObject():New() as json
    local jPrt:=JSONObject():New() as json
    local jInputMM:=JSONObject():New() as json
    local lHasMeta:=.F. as logical

    paramtype 1 var cType as character optional default "ITEM"
    paramtype 2 var cName as character optional default ""
    paramtype 3 var nRow as numeric optional default 0
    paramtype 4 var nCol as numeric optional default 0
    paramtype 5 var nWidth as numeric optional default 0
    paramtype 6 var nHeight as numeric optional default 0
    paramtype 7 var cMethod as character optional default ""
    paramtype 8 var cFont as character optional default ""
    paramtype 9 var nFontSize as numeric optional default 0
    paramtype 10 var lBold as logical optional default .F.
    paramtype 11 var nOrient as numeric optional default 0
    paramtype 12 var nYmm as numeric optional default 0
    paramtype 13 var nXmm as numeric optional default 0
    paramtype 14 var nWmm as numeric optional default 0
    paramtype 15 var nHmm as numeric optional default 0
    paramtype 16 var cObs as character optional default ""

    if (ValType(::aItems)!="A")
        ::aItems:=Array(0)
    endif

    jItem["name"]:=AllTrim(cName)
    jItem["type"]:=Upper(AllTrim(cType))
    jItem["row"]:=nRow
    jItem["col"]:=nCol
    jItem["width"]:=nWidth
    jItem["height"]:=nHeight
    jItem["xmm"]:=::PxToMmXRaw(nCol)
    jItem["ymm"]:=::PxToMmYRaw(nRow)
    jItem["wmm"]:=::PxToMmXRaw(nWidth)
    jItem["hmm"]:=::PxToMmYRaw(nHeight)

    jPrt["x"]:=::nOriginCol+nCol
    jPrt["y"]:=::nOriginRow+nRow
    jPrt["w"]:=nWidth
    jPrt["h"]:=nHeight
    jItem["prt"]:=jPrt

    lHasMeta:=(!Empty(cMethod)).or.(!Empty(cFont)).or.(nFontSize>0).or.(!Empty(cObs)).or.(PCount()>=12)

    if (lHasMeta)
        if (!Empty(cMethod))
            jItem["method"]:=Upper(AllTrim(cMethod))
        endif
        if (!Empty(cFont))
            jItem["font"]:=AllTrim(cFont)
        endif
        if (nFontSize>0)
            jItem["font_size"]:=nFontSize
        endif
        jItem["bold"]:=lBold
        jItem["orient"]:=nOrient

        if (PCount()>=13)
            jInputMM["x"]:=nXmm
            jInputMM["y"]:=nYmm
            jInputMM["w"]:=nWmm
            jInputMM["h"]:=nHmm
            jItem["input_mm"]:=jInputMM
        endif

        if (!Empty(cObs))
            jItem["obs"]:=AllTrim(cObs)
        endif
    endif

    aAdd(::aItems,jItem)

return(jItem)

method GetItems() class TLayoutDesigner
return(::aItems)

method ClearItems() class TLayoutDesigner

    if (ValType(::aItems)=="A")
        aSize(::aItems,0)
    else
        ::aItems:=Array(0)
    endif

return(self)

method ExportJson() class TLayoutDesigner

    local cKey:="" as character

    local jOut:=JSONObject():New() as json
    local jItem as json

    local nItem:=0 as numeric

    for nItem:=1 to Len(::aItems)

        jItem:=::aItems[nItem]

        if (ValType(jItem)$"JO")

            cKey:=AllTrim(jItem["name"])

            if (Empty(cKey))
                cKey:=AllTrim(jItem["type"])+"_"+AllTrim(Str(nItem))
            endif

            jOut[cKey]:=JSONObject():New()
            jOut[cKey]["type"]:=jItem["type"]

            jOut[cKey]["px"]:=JSONObject():New()
            jOut[cKey]["px"]["x"]:=jItem["col"]
            jOut[cKey]["px"]["y"]:=jItem["row"]
            jOut[cKey]["px"]["w"]:=jItem["width"]
            jOut[cKey]["px"]["h"]:=jItem["height"]

            jOut[cKey]["mm"]:=JSONObject():New()
            jOut[cKey]["mm"]["x"]:=jItem["xmm"]
            jOut[cKey]["mm"]["y"]:=jItem["ymm"]
            jOut[cKey]["mm"]["w"]:=jItem["wmm"]
            jOut[cKey]["mm"]["h"]:=jItem["hmm"]

            if (jItem:HasProperty("prt"))
                jOut[cKey]["prt"]:=jItem["prt"]
            endif
            if (jItem:HasProperty("method"))
                jOut[cKey]["method"]:=jItem["method"]
            endif
            if (jItem:HasProperty("font"))
                jOut[cKey]["font"]:=jItem["font"]
            endif
            if (jItem:HasProperty("font_size"))
                jOut[cKey]["font_size"]:=jItem["font_size"]
            endif
            if (jItem:HasProperty("bold"))
                jOut[cKey]["bold"]:=jItem["bold"]
            endif
            if (jItem:HasProperty("orient"))
                jOut[cKey]["orient"]:=jItem["orient"]
            endif
            if (jItem:HasProperty("input_mm"))
                jOut[cKey]["input_mm"]:=jItem["input_mm"]
            endif
            if (jItem:HasProperty("obs"))
                jOut[cKey]["obs"]:=jItem["obs"]
            endif

        endif

    next nItem

return(jOut:ToJSON())

method ExportText() class TLayoutDesigner

    local cOut:="" as character
    local cCRLF:=CRLF as character

    local jItem as json

    local nItem:=0 as numeric

    for nItem:=1 to Len(::aItems)
        jItem:=::aItems[nItem]
        if (ValType(jItem)$"JO")
            cOut+=AllTrim(jItem["type"])+" "+AllTrim(jItem["name"])+cCRLF
            cOut+="PX: X="+::FmtNum(jItem["col"])+;
                  " Y="+::FmtNum(jItem["row"])+;
                  " W="+::FmtNum(jItem["width"])+;
                  " H="+::FmtNum(jItem["height"])+cCRLF
            cOut+="MM: X="+::FmtNum(jItem["xmm"],2)+;
                  " Y="+::FmtNum(jItem["ymm"],2)+;
                  " W="+::FmtNum(jItem["wmm"],2)+;
                  " H="+::FmtNum(jItem["hmm"],2)+cCRLF
            if (jItem:HasProperty("prt"))
                cOut+="PRT: X="+::FmtNum(jItem["prt"]["x"],2)+;
                      " Y="+::FmtNum(jItem["prt"]["y"],2)+;
                      " W="+::FmtNum(jItem["prt"]["w"],2)+;
                      " H="+::FmtNum(jItem["prt"]["h"],2)+cCRLF
            endif
            if (jItem:HasProperty("method"))
                cOut+="METHOD: "+AllTrim(jItem["method"])
                if (jItem:HasProperty("font"))
                    cOut+=" FONT="+AllTrim(jItem["font"])
                endif
                if (jItem:HasProperty("font_size"))
                    cOut+=" SIZE="+::FmtNum(jItem["font_size"],2)
                endif
                if (jItem:HasProperty("bold"))
                    cOut+=" BOLD="+if(jItem["bold"],".T.",".F.")
                endif
                if (jItem:HasProperty("orient"))
                    cOut+=" ORIENT="+::FmtNum(jItem["orient"])
                endif
                cOut+=cCRLF
            endif
            if (jItem:HasProperty("input_mm"))
                cOut+="INPUT_MM: X="+::FmtNum(jItem["input_mm"]["x"],2)+;
                      " Y="+::FmtNum(jItem["input_mm"]["y"],2)+;
                      " W="+::FmtNum(jItem["input_mm"]["w"],2)+;
                      " H="+::FmtNum(jItem["input_mm"]["h"],2)+cCRLF
            endif
            if (jItem:HasProperty("obs"))
                cOut+="OBS: "+AllTrim(jItem["obs"])+cCRLF
            endif
            cOut+=cCRLF
        endif
    next nItem

return(cOut)

method DrawLine(nRow1,nCol1,nRow2,nCol2,nColor,cPixel) class TLayoutDesigner

    local aIni as array
    local aFim as array

    paramtype 1 var nRow1 as numeric optional default 0
    paramtype 2 var nCol1 as numeric optional default 0
    paramtype 3 var nRow2 as numeric optional default 0
    paramtype 4 var nCol2 as numeric optional default 0
    paramtype 5 var nColor as numeric optional default ::nColorBox
    paramtype 6 var cPixel as character optional

    if (ValType(::oPrint)=="O")
        aIni:=::ApplyOrigin(nRow1,nCol1)
        aFim:=::ApplyOrigin(nRow2,nCol2)
        //FWMsPrinter():Line(<nTop>,<nLeft>,<nBottom>,<nRight>,[nColor],[cPixel])
        if (::IsLegacyFWMSPrinter())
            ::oPrint:Line(aIni[1],aIni[2],aFim[1],aFim[2])
        else
            ::oPrint:Line(aIni[1],aIni[2],aFim[1],aFim[2],nColor,cPixel)
        endif
        FWFreeArray(@aIni)
        FWFreeArray(@aFim)
    endif

return(self)

method DrawBox(nRow1,nCol1,nRow2,nCol2,nColorBox,cPixel) class TLayoutDesigner

    paramtype 1 var nRow1 as numeric optional default 0
    paramtype 2 var nCol1 as numeric optional default 0
    paramtype 3 var nRow2 as numeric optional default 0
    paramtype 4 var nCol2 as numeric optional default 0
    paramtype 5 var nColorBox as numeric optional default ::nColorBox
    paramtype 6 var cPixel as character optional

    ::DrawLine(nRow1,nCol2,nRow2,nCol2,nColorBox,cPixel)
    ::DrawLine(nRow2,nCol2,nRow2,nCol1,nColorBox,cPixel)
    ::DrawLine(nRow2,nCol1,nRow1,nCol1,nColorBox,cPixel)
    ::DrawLine(nRow1,nCol1,nRow1,nCol2,nColorBox,cPixel)

return(self)

method DrawText(nRow,nCol,cText,oFont,nColor) class TLayoutDesigner

    local aPos as array
    local xSayFont as variant

    paramtype 1 var nRow as numeric optional default 0
    paramtype 2 var nCol as numeric optional default 0
    paramtype 3 var cText as character optional default ""
    paramtype 4 var oFont as object optional default ::oFont
    paramtype 5 var nColor as numeric optional default ::nColorText

    if (ValType(::oPrint)=="O")
        xSayFont:=::PrinterFont(oFont,6,.T.)
        aPos:=::ApplyOrigin(nRow,nCol)
        if (::IsLegacyFWMSPrinter())
            ::oPrint:Say(aPos[1],aPos[2],cText,xSayFont,0,nColor)
        else
            ::oPrint:Say(aPos[1],aPos[2],cText,xSayFont,nil,nColor)
        endif
        if (ValType(xSayFont)=="O")
            FreeObj(@xSayFont)
        elseif (ValType(xSayFont)=="A")
            FWFreeArray(@xSayFont)
        endif
        FWFreeArray(@aPos)
    endif

return(self)

method DrawGuideLine(nRow1,nCol1,nRow2,nCol2,nColor) class TLayoutDesigner

    paramtype 1 var nRow1 as numeric optional default 0
    paramtype 2 var nCol1 as numeric optional default 0
    paramtype 3 var nRow2 as numeric optional default 0
    paramtype 4 var nCol2 as numeric optional default 0
    paramtype 5 var nColor as numeric optional default ::nColorBox

    if (::lHighlightGrid)
        ::DrawLine(nRow1+1,nCol1+1,nRow2+1,nCol2+1,::nColorGridBack)
    endif

    ::DrawLine(nRow1,nCol1,nRow2,nCol2,nColor)

return(self)

method DrawGuideText(nRow,nCol,cText,oFont,nColor) class TLayoutDesigner

    paramtype 1 var nRow as numeric optional default 0
    paramtype 2 var nCol as numeric optional default 0
    paramtype 3 var cText as character optional default ""
    paramtype 4 var oFont as object optional default ::oFont
    paramtype 5 var nColor as numeric optional default ::nColorGrid

    if (::lHighlightGrid)
        ::DrawText(nRow+1,nCol+1,cText,oFont,::nColorGridBack)
    endif

    ::DrawText(nRow,nCol,cText,oFont,nColor)

return(self)

method DrawMmCornerText(nHeight,nWidth,nColor) class TLayoutDesigner

    local cText:="" as character
    local nRow:=0 as numeric
    local nCol:=0 as numeric

    paramtype 1 var nHeight as numeric optional default 0
    paramtype 2 var nWidth as numeric optional default 0
    paramtype 3 var nColor as numeric optional default ::nColorGrid

    nRow:=0-(::nTextLineHeight+::nTextOffset)
    if (::nOriginRow+nRow<::nTextOffset)
        nRow:=::nRulerTickSize+::nTextOffset
    endif

    ::DrawGuideText(nRow,::nTextOffset,"mm (0,0)",::oFont,nColor)

    cText:=::FmtNum(::PxToMmXRaw(nWidth))
    nCol:=nWidth+::nTextOffset

    ::DrawGuideText(nRow,nCol,cText,::oFont,nColor)

    cText:=::FmtNum(::PxToMmYRaw(nHeight))
    nRow:=nHeight+::nTextOffset

    ::DrawGuideText(nRow,::nTextOffset,cText,::oFont,nColor)

return(self)

method Info(cName,nRow,nCol,nWidth,nHeight) class TLayoutDesigner

    local aInfo as array
    local cInfo:="" as character
    local nLine:=0 as numeric

    aInfo:=::InfoLines(cName,nRow,nCol,nWidth,nHeight)

    for nLine:=1 to Len(aInfo)
        if (nLine>1)
            cInfo+=" | "
        endif
        cInfo+=aInfo[nLine]
    next nLine

    FWFreeArray(@aInfo)

return(cInfo)

method InfoLines(cName,nRow,nCol,nWidth,nHeight) class TLayoutDesigner

    local aInfo:=Array(0)

    paramtype 1 var cName as character optional default "AREA"
    paramtype 2 var nRow as numeric optional default 0
    paramtype 3 var nCol as numeric optional default 0
    paramtype 4 var nWidth as numeric optional default 0
    paramtype 5 var nHeight as numeric optional default 0

    aAdd(aInfo,AllTrim(cName))

    if (::cInfoMode=="BOTH" .or. ::cInfoMode=="PX")
        aAdd(aInfo,;
            "PX: X="+::FmtNum(nCol)+;
            " Y="+::FmtNum(nRow)+;
            " W="+::FmtNum(nWidth)+;
            " H="+::FmtNum(nHeight))
    endif

    if (::cInfoMode=="BOTH" .or. ::cInfoMode=="MM")
        aAdd(aInfo,;
            "MM: X="+::FmtNum(::PxToMmXRaw(nCol),2)+;
            " Y="+::FmtNum(::PxToMmYRaw(nRow),2)+;
            " W="+::FmtNum(::PxToMmXRaw(nWidth),2)+;
            " H="+::FmtNum(::PxToMmYRaw(nHeight),2))
    endif

return(aInfo)

method FmtNum(nValue,nDec) class TLayoutDesigner

    paramtype 1 var nValue as numeric optional default 0
    paramtype 2 var nDec as numeric optional default 0

return(AllTrim(Str(nValue,18,nDec)))

method IsTextStep(nIndex) class TLayoutDesigner

    local nEvery:=::nRulerTextStep

    paramtype 1 var nIndex as numeric optional default 0

    if (nEvery<=0)
        nEvery:=1
    endif

return(((nIndex==0).or.(Mod(nIndex,nEvery)==0)))

method Finalize() class TLayoutDesigner
    ::oPrint:=nil
    FreeObj(@::oFont)
return(self)

static method Pixel2MM(nPixel,nDPI,nMMPerInch) class TLayoutDesigner
    paramtype 1 var nPixel as numeric optional default 1
    paramtype 2 var nDPI as numeric optional default 300
    paramtype 3 var nMMPerInch as numeric optional default 25.4
return(nPixel*(nMMPerInch/nDPI))

static method MM2Pixel(nMM,nDPI,nMMPerInch) class TLayoutDesigner
    paramtype 1 var nMM  as numeric optional default 1
    paramtype 2 var nDPI as numeric optional default 300
    paramtype 3 var nMMPerInch as numeric optional default 25.4
return Round((nMM/nMMPerInch)*nDPI,0)
