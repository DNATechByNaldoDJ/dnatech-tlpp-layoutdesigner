method SetGridSubdivisions(nSubDivisions,nColor) class TLayoutDesigner

    paramtype 1 var nSubDivisions as numeric optional default 1
    paramtype 2 var nColor as numeric optional default ::nColorGridSub

    if (nSubDivisions<1)
        nSubDivisions:=1
    endif

    ::nGridSubDivisions:=Int(nSubDivisions)
    ::nColorGridSub:=nColor

return(self)

method SetGridTextMode(cMode) class TLayoutDesigner

    paramtype 1 var cMode as character optional default "STEPS"

    cMode:=Upper(AllTrim(cMode))

    if (cMode=="STEP")
        cMode:="STEPS"
    elseif (cMode=="CORNER")
        cMode:="CORNERS"
    endif

    if ((cMode=="STEPS").or.(cMode=="CORNERS").or.(cMode=="NONE"))
        ::cGridTextMode:=cMode
    endif

return(self)

