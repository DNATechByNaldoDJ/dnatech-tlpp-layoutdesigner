#include "totvs.ch"
#include "rptdef.ch"
#include "fwprintsetup.ch"

#define TLD_CALIB_WMM       200
#define TLD_CALIB_HMM       130
#define TLD_CALIB_ORIG_ROW  0
#define TLD_CALIB_ORIG_COL  0

/*{Protheus.doc} TLD_CALIB
    Programa empirico de calibracao do TLayoutDesigner com FWMSPrinter.

    Gera um PDF 200 x 130 mm em paginas separadas para medir no Inkscape:
    - Say()
    - SayAlign()
    - Code128()
    - EAN13()
    - FWMsBar()

    @type User Function
    @author Marinaldo de Jesus
    @since 27/06/2026
*/
User Function TLD_CALIB()

    FWMsgRun(nil,{||RPCSetEnv("01","0101")},"Preparing environment...","Please wait")
    __cInternet:=nil
    FWMsgRun(nil,{||TLD_CALIB()},"Printing ...","Please wait")
    RPCClearEnv()

return

Static Function TLD_CALIB()

    Local cPrinter:="tld_calib_"+DToS(Date())+"_"+StrTran(Time(),":","") as character
    Local cExport:="" as character
    Local cExportFile as character

    //https://tdn.totvs.com/display/tec/TFont
    Local oFont_03_00:=TFont():New("Arial",nil,03,nil,.T.,nil,nil,nil,.T.,.F.) as object
    Local oFont_04_50:=TFont():New("Arial",nil,04.5,nil,.T.,nil,nil,nil,.T.,.F.) as object
    Local oFont_06_00:=TFont():New("Arial",nil,06,nil,.T.,nil,nil,nil,.T.,.F.) as object
    Local oFont_06_50:=TFont():New("Arial",nil,06.5,nil,.T.,nil,nil,nil,.T.,.F.) as object
    Local oFont_12_00:=TFont():New("Arial",nil,12,nil,.T.,nil,nil,nil,.T.,.F.) as object
    Local oFont_26_00:=TFont():New("Arial",nil,26,nil,.T.,nil,nil,nil,.T.,.F.) as object

    Local oFWMSPrinter as object
    Local oPrinterSetup as object

    if (!FindClass("TLayoutDesigner"))
        Alert("Classe TLayoutDesigner nao encontrada no RPO.")
        return
    endif

    //https://tdn.totvs.com/display/public/framework/FWMsPrinter
    //FWMsPrinter():New(<cFilePrintert>,[nDevice],[lAdjustToLegacy],[cPathInServer],[lDisabeSetup],[lTReport],[@oPrinterSetup],[cPrinter],[lServer],[lPDFAsPNG],[lRaw],[lViewPDF],[nQtdCopy])-->oFWMsPrinter
    oFWMSPrinter:=FWMSPrinter():New(cPrinter,IMP_PDF,.F./*lAdjustToLegacy*/,/*cPathInServer*/,.T./*lDisabeSetup*/,/*lTReport*/,@oPrinterSetup/*@oPrinterSetup*/,/*cPrinter*/,.T./*lServer*/,/*lPDFAsPNG*/,/*lRaw*/,/*lViewPDF*/,/*nQtdCopy*/)
    oFWMSPrinter:SetMargin(0,0,0,0)
    oFWMSPrinter:SetLandscape()
    oFWMSPrinter:SetPaperSize(0,TLD_CALIB_HMM,TLD_CALIB_WMM)
    oFWMSPrinter:SetUp()

    if (!Empty(oFWMSPrinter:cPrinter))

        cExport+=TLDCalibSayPage(oFWMSPrinter,oFont_26_00,oFont_12_00,oFont_06_00,oFont_03_00,oFont_06_50,oFont_04_50)
        cExport+=TLDCalibBarPage(oFWMSPrinter,oFont_06_00,oFont_12_00)

        cExport+=TLDCalibFWMsPage(oFWMSPrinter,oFont_06_00)

        ConOut(cExport)
        cExportFile:=cPrinter+".txt"
        MemoWrite(cExportFile,cExport)

        oFWMSPrinter:Preview()

    endif

    if ((!Empty(cExportFile)).and.(File(cExportFile)))
        EEcView(MemoRead(cExportFile),ProcName())
    endif

    FreeObj(@oPrinterSetup)
    FreeObj(@oFWMSPrinter)
    FreeObj(@oFont_03_00)
    FreeObj(@oFont_04_50)
    FreeObj(@oFont_06_00)
    FreeObj(@oFont_06_50)
    FreeObj(@oFont_12_00)
    FreeObj(@oFont_26_00)

return

Static Function TLDCalibNewPage(oFWMSPrinter,cTitle)

    Local oDesign as object

    oFWMSPrinter:StartPage()

    oDesign:=TLayoutDesigner():New(oFWMSPrinter)
    oDesign:SetPageMm(TLD_CALIB_WMM,TLD_CALIB_HMM,TLD_CALIB_ORIG_ROW,TLD_CALIB_ORIG_COL)
    oDesign:SetColors(RGB(0,80,255),RGB(255,0,0),RGB(255,0,0),RGB(0,80,255))
    oDesign:SetGridHighlight(.F.,RGB(255,255,255))
    oDesign:SetGridSubdivisions(5,RGB(190,215,255))
    oDesign:SetRulerTextStep(2)
    oDesign:ShowMarkInfo(.F.)

    oDesign:SetGridTextMode("NONE")
    oDesign:GridMm(10,oDesign:MmToPdf(TLD_CALIB_HMM),oDesign:MmToPdf(TLD_CALIB_WMM))
    oDesign:SetGridTextMode("STEPS")
    oDesign:RulerMm(10,oDesign:MmToPdf(TLD_CALIB_HMM),oDesign:MmToPdf(TLD_CALIB_WMM))
    oDesign:Mark("AREA_PAGINA",0,0,oDesign:MmToPdf(TLD_CALIB_WMM),oDesign:MmToPdf(TLD_CALIB_HMM))
    oDesign:TextMm(cTitle,2,2)

return(oDesign)

Static Function TLDCalibClosePage(oFWMSPrinter,oDesign)

    Local cExport:="" as character

    cExport:=oDesign:ExportText()
    oDesign:Finalize()
    FreeObj(@oDesign)
    oFWMSPrinter:EndPage()

return(cExport)

Static Function TLDCalibSayPage(oFWMSPrinter,oFont_26_00,oFont_12_00,oFont_06_00,oFont_03_00,oFont_06_50,oFont_04_50)

    Local oDesign as object

    oDesign:=TLDCalibNewPage(oFWMSPrinter,"TLD_CALIB PAG1 SAY SAYALIGN")

    TLDCalibLegend(oDesign,"SAY Arial 26 Bold text=20",13,20)
    oDesign:CalibSay("SAY_ARIAL_26_20","20",20,20,oFont_26_00,26,"Arial",.T.)

    TLDCalibLegend(oDesign,"SAY Arial 12 Bold text=LITROS",34,20)
    oDesign:CalibSay("SAY_ARIAL_12_LITROS","LITROS",38,20,oFont_12_00,12,"Arial",.T.)

    TLDCalibLegend(oDesign,"SAY Arial 6 Bold text=Codigo prod.",50,20)
    oDesign:CalibSay("SAY_ARIAL_06_LABEL","Codigo prod.:",54,20,oFont_06_00,6,"Arial",.T.)

    TLDCalibLegend(oDesign,"SAY Arial 6.5 Bold text=Peso liquido",50,100)
    oDesign:CalibSay("SAY_ARIAL_065_LABEL","Peso liquido:",54,100,oFont_06_50,6.5,"Arial",.T.)

    TLDCalibLegend(oDesign,"SAY Arial 4.5 Bold text=000777429",64,20)
    oDesign:CalibSay("SAY_ARIAL_045_VALUE","000777429",68,20,oFont_04_50,4.5,"Arial",.T.)

    TLDCalibLegend(oDesign,"SAYALIGN Arial 12 Bold box=60x10 align=2,2",78,20)
    oDesign:CalibSayAlign("SAYALIGN_ARIAL_12_LITROS","LITROS",82,20,oFont_12_00,60,10,2,2,12,"Arial",.T.)

    TLDCalibLegend(oDesign,"SAYALIGN Arial 26 Bold box=60x18 align=2,2",96,20)
    oDesign:CalibSayAlign("SAYALIGN_ARIAL_26_20","20",100,20,oFont_26_00,60,18,2,2,26,"Arial",.T.)

    TLDCalibLegend(oDesign,"SAY Arial 3 Bold text=20,5000 kg",118,20)
    oDesign:CalibSay("SAY_ARIAL_03_PESO","20,5000 kg",122,20,oFont_03_00,3,"Arial",.T.)

return(TLDCalibClosePage(oFWMSPrinter,oDesign))

Static Function TLDCalibBarPage(oFWMSPrinter,oFont_06_00,oFont_12_00)

    Local oDesign as object

    oDesign:=TLDCalibNewPage(oFWMSPrinter,"TLD_CALIB PAG2 CODE128 EAN13")

    TLDCalibLegend(oDesign,"CODE128 GTIN14 width=72 height=16",16,20)
    TLDCalibCode128(oFWMSPrinter,oDesign,"CODE128_72_16",20,20,"17898254732378",72,16,oFont_06_00)

    TLDCalibLegend(oDesign,"CODE128 GTIN14 width=85 height=25",43,20)
    TLDCalibCode128(oFWMSPrinter,oDesign,"CODE128_85_25",47,20,"17898254732378",85,25,oFont_06_00)

    TLDCalibLegend(oDesign,"EAN13 width=72 height=16",76,20)
    TLDCalibEAN13(oFWMSPrinter,oDesign,"EAN13_72_16",80,20,"7898254732378",72,16,oFont_12_00)

    TLDCalibLegend(oDesign,"EAN13 width=85 height=25",103,20)
    TLDCalibEAN13(oFWMSPrinter,oDesign,"EAN13_85_25",107,20,"7898254732378",85,25,oFont_12_00)

return(TLDCalibClosePage(oFWMSPrinter,oDesign))

Static Function TLDCalibFWMsPage(oFWMSPrinter,oFont_06_00)

    Local oDesign as object

    oDesign:=TLDCalibNewPage(oFWMSPrinter,"TLD_CALIB PAG3 FWMSBAR EAN13")

    TLDCalibLegend(oDesign,"FWMsBar EAN13 lHor=.T. lCmtr2Pix=.F.",16,20)
    TLDCalibLegend(oDesign,"FWMsBar EAN13 lHor=.T. lCmtr2Pix=.T.",44,20)
    TLDCalibLegend(oDesign,"FWMsBar EAN13 lHor=.T. lCmtr2Pix=nil",72,20)
    TLDCalibLegend(oDesign,"FWMsBar EAN13 lHor=.F. lCmtr2Pix=.F.",100,20)

    TLDCalibFWMsBar(oFWMSPrinter,oDesign,"FWMS_EAN13_HOR_FALSE",20,20,"EAN13","7898254732378",72,16,.T.,.F.,oFont_06_00)
    TLDCalibFWMsBar(oFWMSPrinter,oDesign,"FWMS_EAN13_HOR_TRUE",48,20,"EAN13","7898254732378",72,16,.T.,.T.,oFont_06_00)
    TLDCalibFWMsBar(oFWMSPrinter,oDesign,"FWMS_EAN13_HOR_NIL",76,20,"EAN13","7898254732378",72,16,.T.,nil,oFont_06_00)
    TLDCalibFWMsBar(oFWMSPrinter,oDesign,"FWMS_EAN13_VERT_FALSE",104,20,"EAN13","7898254732378",72,16,.F.,.F.,oFont_06_00)

    TLDCalibLegend(oDesign,"FWMsBar INT25 lHor=.F. lCmtr2Pix=.F.",115,20)
    TLDCalibFWMsBar(oFWMSPrinter,oDesign,"FWMS_INT25_HOR_FALSE",120,20,"INT25","34190184239878442204400130920002152710000053475",72,16,.F.,.F.,oFont_06_00)


return(TLDCalibClosePage(oFWMSPrinter,oDesign))

Static Function TLDCalibLegend(oDesign,cText,nYmm,nXmm)
    oDesign:TextMm(cText,nYmm,nXmm)
return(nil)

Static Function TLDCalibRefBox(oDesign,cName,cMethod,nYmm,nXmm,nWidth,nHeight,cObs)

    Local nRow:=oDesign:MmToPxY(nYmm) as numeric
    Local nCol:=oDesign:MmToPxX(nXmm) as numeric

    oDesign:CrossMm(cName+"_ORIG",nYmm,nXmm,3)
    oDesign:DrawBox(nRow,nCol,nRow+nHeight,nCol+nWidth,RGB(255,0,0))
    oDesign:AddItem("CALIB",cName,nRow,nCol,nWidth,nHeight,cMethod,"",0,.F.,0,nYmm,nXmm,0,0,cObs)

return(nil)

Static Function TLDCalibCode128(oFWMSPrinter,oDesign,cName,nYmm,nXmm,cCode,nTamBar,nAltBar,oFont)

    Local nY:=oDesign:MmToPrtY(nYmm) as numeric
    Local nX:=oDesign:MmToPrtX(nXmm) as numeric

    TLDCalibRefBox(oDesign,cName,"CODE128",nYmm,nXmm,nTamBar,nAltBar,;
        "code="+cCode+" width_arg="+AllTrim(Str(nTamBar))+" height_arg="+AllTrim(Str(nAltBar)))

    oFWMSPrinter:Code128(nY,nX,cCode,nTamBar,nAltBar,.F.,nil,nTamBar)
    oFWMSPrinter:Say(nY+nAltBar+5,nX,cCode,oFont)

return(nil)

Static Function TLDCalibEAN13(oFWMSPrinter,oDesign,cName,nYmm,nXmm,cCode,nTamBar,nAltBar,oFont)

    Local nY:=oDesign:MmToPrtY(nYmm) as numeric
    Local nX:=oDesign:MmToPrtX(nXmm) as numeric

    TLDCalibRefBox(oDesign,cName,"EAN13",nYmm,nXmm,nTamBar,nAltBar,;
        "code="+cCode+" width_arg="+AllTrim(Str(nTamBar))+" height_arg="+AllTrim(Str(nAltBar)))

    oFWMSPrinter:EAN13(nY,nX,cCode,nTamBar,nAltBar)
    oFWMSPrinter:Say(nY+nAltBar+15,nX,cCode,oFont)

return(nil)

Static Function TLDCalibFWMsBar(oFWMSPrinter,oDesign,cName,nYmm,nXmm,cTypeBar,cCode,nTamBar,nAltBar,lHorBar,lCmtr2Pix,oFont)

    Local nY:=oDesign:MmToPrtY(nYmm) as numeric
    Local nX:=oDesign:MmToPrtX(nXmm) as numeric
    Local cObs:="code="+cCode+" width_arg="+AllTrim(Str(nTamBar))+" height_arg="+AllTrim(Str(nAltBar)) as character

    DEFAULT oFont:=nil

    cObs+=" lHorBar="+if(lHorBar,".T.",".F.")
    cObs+=" lCmtr2Pix="+TLDCalibLogValue(lCmtr2Pix)
    if (ValType(oFont)=="O")
        cObs+=" font_ref=ok"
    endif

    TLDCalibRefBox(oDesign,cName,"FWMSBAR",nYmm,nXmm,nTamBar,nAltBar,cObs)

    // FWMsBar(cTypeBar,nRow,nCol,cCode,oPrint,lCheck,Color,lHorz,nWidth,nHeigth,lBanner,cFont,cMode,lPrint,nPFWidth,nPFHeigth,lCmtr2Pix)
    // Se passar oFWMSPrinter no lugar de oFWMSPrinter:oPrint oFWMSPrinter:oFileWriter retornará como "nil" gerando erros nos próximos passos da impressão
    //FWMsPrinter():FWMsBar(cTypeBar,nRow,nCol,cCode,oPrint,lCheck,Color,lHorz, nWidth,nHeigth,lBanner,cFont,cMode,lPrint,nPFWidth,nPFHeigth,lCmtr2Pix)
    oFWMSPrinter:FWMsBar(cTypeBar,nY,nX,cCode,oFWMSPrinter:oPrint,.F.,nil,lHorBar,nTamBar,nAltBar,nil,"Arial",nil,.T.,nil,nil,lCmtr2Pix)

return(nil)

Static Function TLDCalibLogValue(xValue)

    Local cValue:="nil" as character

    if (ValType(xValue)=="L")
        cValue:=if(xValue,".T.",".F.")
    elseif (ValType(xValue)=="N")
        cValue:=AllTrim(Str(xValue))
    elseif (ValType(xValue)=="C")
        cValue:=AllTrim(xValue)
    endif

return(cValue)
